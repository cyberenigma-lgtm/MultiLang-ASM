; ============================================================
; DEMO PORTUGUÊS-BR (MultiLang-ASM)
; Exemplo de função de soma em linguagem natural
; ============================================================

funcao_somar:
    empilhar    rbp         ; Guardar base da pilha
    mover       rbp, rsp    ; Nova base
    
    somar       rdi, rsi    ; Somar argumentos
    mover       rax, rdi    ; Resultado em RAX
    
    desempilhar rbp         ; Restaurar base
    retornar                ; Voltar ao fluxo principal

principal:
    limpar_interrupcoes     ; cli
    mover       rdi, 10
    mover       rsi, 20
    chamar      funcao_somar
    parar                   ; hlt
