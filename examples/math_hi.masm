; MultiLang-ASM: उन्नत अंक गणित उदाहरण (Hindi)
; v0.7 Global Expansion

अनुभाग .डेटा
    नंबर1: dq 100
    नंबर2: dq 50
    परिणाम: dq 0

अनुभाग .पाठ
    वैश्विक _शुरू

_शुरू:
    स्थानांतरित rax, [नंबर1]    ; rax = 100
    जोड़ें rax, [नंबर2]        ; rax = 150
    घटाएं rax, 25              ; rax = 125
    स्थानांतरित [परिणाम], rax

    तुलना rax, 100
    यदि_बड़ा .बड़ा_है
    कूदें .छोटा_है

.बड़ा_है:
    स्थानांतरित rdi, 1
    कूदें .समाप्त

.छोटा_है:
    स्थानांतरित rdi, 0

.समाप्त:
    स्थानांतरित rax, 60         ; exit
    सिस्टम_कॉल
