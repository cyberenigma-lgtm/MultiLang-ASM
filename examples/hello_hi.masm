; MultiLang-ASM Example (hi)
; Run with: python ../mlasm.py auto hello_hi.masm

; Hello World in MultiLang-ASM
section .text
global _start

_start:
    ; Write(1, msg, 13)
    bhejo rax, 1
    bhejo rdi, 1
    bhejo rsi, msg
    bhejo rdx, 13
    syscall

    ; Exit(0)
    bhejo rax, 60
    bhejo rdi, 0
    syscall

section .data
    msg db "Hello World!", 0xA
