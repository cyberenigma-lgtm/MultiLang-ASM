; MultiLang-ASM Example (ja)
; Run with: python ../mlasm.py auto hello_ja.masm

; Hello World in MultiLang-ASM
section .text
global _start

_start:
    ; Write(1, msg, 13)
    移動 rax, 1
    移動 rdi, 1
    移動 rsi, msg
    移動 rdx, 13
    システムコール

    ; Exit(0)
    移動 rax, 60
    移動 rdi, 0
    システムコール

section .data
    msg db "Hello World!", 0xA
