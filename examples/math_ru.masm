; MultiLang-ASM: Расширенный пример арифметики (Russian)
; v0.7 Global Expansion

секция .данные
    число: dq 42

секция .текст
    глобальный _старт

_старт:
    перенести rax, [число]
    сложить rax, 58            ; rax = 100
    увеличить rax              ; rax = 101
    
    ; Использование стека
    положить rax
    перенести rax, 0
    извлечь rax                ; rax = 101

    сравнить rax, 100
    если_больше .успех
    прыгнуть .конец

.успех:
    перенести rdi, 7           ; Код успеха
    прыгнуть .конец

.конец:
    перенести rax, 60          ; exit
    системный_вызов
