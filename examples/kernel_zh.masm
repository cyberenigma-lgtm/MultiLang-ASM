; ============================================================================
; 最小核心 - 中文版本 (繁體中文)
; ============================================================================
; 這是啟動載入程式載入並執行的核心。
; 展示低階程式設計的基本概念。
;
; 涵蓋的概念：
; - 影像和鍵盤的 BIOS 呼叫
; - 函式和呼叫慣例
; - 字串操作
; - 作業系統的無限迴圈
; ============================================================================

[bits 16]                   ; 16 位元程式碼 (真實模式)
                            ; 為什麼？啟動載入程式在真實模式下將控制權交給我們
                            ; 要切換到 32 位元需要保護模式

[org 0x1000]                ; 原點在 0x1000
                            ; 為什麼？啟動載入程式將我們載入這裡
                            ; 所有位址相對於 0x1000

核心開始:
    ; ------------------------------------------------------------------------
    ; 步驟 1：清除螢幕
    ; ------------------------------------------------------------------------
    ; 我們想從乾淨的螢幕開始我們的核心
    
    移動 ah, 0x00           ; AH = 0x00 → 功能「設定影像模式」
                            ; 為什麼？更改影像模式會清除螢幕
                            
    移動 al, 0x03           ; AL = 0x03 → 文字模式 80x25，16 色
                            ; 為什麼是 0x03？這是標準文字模式
                            ; 替代方案：0x12 = VGA 640x480，0x13 = VGA 320x200
                            
    中斷 0x10               ; INT 10h → BIOS 影像呼叫
                            ; 做什麼？重新設定影像模式，清除螢幕
    
    ; ------------------------------------------------------------------------
    ; 步驟 2：顯示核心標題
    ; ------------------------------------------------------------------------
    
    移動 si, 標題           ; SI = 標題位址
                            ; 為什麼用 SI？慣例：SI 用於字串指標
                            
    呼叫 印出               ; 呼叫印出函式
                            ; 做什麼？顯示核心橫幅
    
    ; ------------------------------------------------------------------------
    ; 步驟 3：顯示歡迎訊息
    ; ------------------------------------------------------------------------
    
    移動 si, 訊息           ; SI = 訊息位址
    呼叫 印出               ; 印出歡迎訊息
    
    ; ------------------------------------------------------------------------
    ; 步驟 4：顯示提示符
    ; ------------------------------------------------------------------------
    
    移動 si, 提示符         ; SI = 提示符位址 "> "
    呼叫 印出               ; 顯示提示符
    
    ; ------------------------------------------------------------------------
    ; 步驟 5：主迴圈 (事件迴圈)
    ; ------------------------------------------------------------------------
    ; 每個核心或作業系統都有一個主迴圈：
    ; 1. 等待事件 (按鍵、中斷等)
    ; 2. 處理事件
    ; 3. 更新狀態
    ; 4. 重複
    
主迴圈:
    ; 等待使用者按鍵
    移動 ah, 0x00           ; AH = 0x00 → 功能「等待按鍵」
                            ; 為什麼？阻塞直到有按鍵
                            
    中斷 0x16               ; INT 16h → BIOS 鍵盤呼叫
                            ; 做什麼？AL = 按鍵的 ASCII 碼
                            ; AH = 按鍵的掃描碼
    
    ; 回顯：顯示按下的按鍵
    移動 ah, 0x0E           ; AH = 0x0E → 功能「電傳打字輸出」
                            ; 為什麼？顯示 AL 中的字元
                            
    中斷 0x10               ; INT 10h → 印出字元
                            ; 做什麼？在螢幕上顯示 AL 並移動游標
    
    ; 檢查是否按下 ESC (ASCII 碼 27)
    若相等 關機             ; JE 關機 → 如果是 ESC，執行關機
                            ; 為什麼？讓使用者有退出的方式
    
    ; 如果不是 ESC，繼續迴圈
    跳躍 主迴圈             ; JMP 主迴圈 → 回到開始
                            ; 為什麼？等待下一個按鍵

; ============================================================================
; 關機程序
; ----------------------------------------------------------------------------
; 顯示告別訊息並停止系統
; 在真實的作業系統中，這裡會儲存資料、卸載磁碟等。
; ============================================================================
關機:
    移動 si, 關機訊息       ; SI = 告別訊息位址
    呼叫 印出               ; 顯示訊息
    
無限迴圈:
    取負                    ; HLT → 停止 (halt CPU)
                            ; 為什麼用 HLT？節省能源並減少熱量
                            ; CPU 在低功耗狀態等待中斷
                            
    跳躍 無限迴圈           ; JMP 無限迴圈 → 以防有中斷
                            ; 為什麼？HLT 會在中斷時喚醒
                            ; 跳躍會再次停止它

; ============================================================================
; 函式：印出
; ----------------------------------------------------------------------------
; 印出以 null 結尾的文字字串
;
; 輸入：
;   SI = 字串位址 (以 0 結尾的字串)
;
; 輸出：
;   無
;
; 修改：
;   AX, BX (但用 push/pop 還原)
;
; 演算法：
;   1. 儲存要修改的暫存器
;   2. 當目前位元組不是 0 時：
;        a. 將位元組載入 AL
;        b. 用 INT 10h 印出位元組
;        c. 前進到下一個位元組
;   3. 還原暫存器
;   4. 返回
; ============================================================================
印出:
    推入 ax                 ; PUSH AX → 儲存到堆疊
                            ; 為什麼？慣例：函式不應該
                            ; 改變呼叫者的暫存器
                            
    推入 bx                 ; PUSH BX → 儲存到堆疊
    
.循環:                      ; 區域標籤 (. 表示它是印出的區域標籤)
    載入有效位址 si         ; LODSB → AL = [DS:SI]; SI = SI + 1
                            ; 做什麼？原子性的載入和遞增操作
                            ; 比 MOV + INC 更有效率
                            
    若相等 .完成            ; JE .完成 → 如果是 0，退出迴圈
                            ; 為什麼 JE？當 ZF (零旗標) = 1 時 JE 跳躍
                            ; CMP 在運算元相等時設定 ZF=1
    
    移動 ah, 0x0E           ; AH = 0x0E → 電傳打字輸出
    移動 bx, 0x07           ; BH = 0 (頁面 0)，BL = 7 (顏色：淺灰)
                            ; 什麼是頁面？文字模式有多個
                            ; 螢幕緩衝區 (頁面) 可快速切換
                            
    中斷 0x10               ; INT 10h → 印出 AL
    
    跳躍 .循環              ; JMP .循環 → 下一個字元
    
.完成:
    彈出 bx                 ; POP BX → 還原原始值
                            ; 為什麼順序相反？堆疊是 LIFO
                            ; (後進先出)
                            
    彈出 ax                 ; POP AX → 還原原始值
    
    返回                    ; RET → 返回呼叫者
                            ; RET 如何運作？POP IP (彈出返回位址)

; ============================================================================
; 資料區段
; ----------------------------------------------------------------------------
; 這裡定義核心使用的所有字串
; db = 定義位元組
; 13 = \r (回車)
; 10 = \n (換行)
; 0 = null 終止符
; ============================================================================

標題      db '========================================', 13, 10
          db '   多語言核心 v0.1', 13, 10
          db '   使用 MultiLang-ASM 建立', 13, 10
          db '========================================', 13, 10, 13, 10, 0
          ; 為什麼需要 13 和 10？在 DOS/Windows 中需要兩者：
          ; 13 將游標移到行首
          ; 10 移到下一行
          ; Unix 只用 10，經典 Mac 只用 13

訊息      db '中文核心正在運作！', 13, 10
          db '按鍵可見回顯...', 13, 10
          db 'ESC 停止系統。', 13, 10, 13, 10, 0

提示符    db '> ', 0        ; 簡單提示符
                            ; 為什麼 '> '？慣例：表示等待輸入

關機訊息  db 13, 10, 13, 10, '系統已停止。可以關閉 QEMU。', 13, 10, 0

; ============================================================================
; 填充
; ----------------------------------------------------------------------------
; 將核心填充到 5 KB (10 個 512 位元組的扇區)
; 為什麼？啟動載入程式正好讀取 10 個扇區
; ============================================================================

times 5120-($-$$) db 0      ; 5120 位元組 = 10 扇區 × 512 位元組/扇區
                            ; $ - $$ = 到目前為止寫入的位元組數
                            ; 用零填充其餘部分
                            ; 為什麼要填充？使大小精確
                            ; 啟動載入程式不會讀取垃圾資料
