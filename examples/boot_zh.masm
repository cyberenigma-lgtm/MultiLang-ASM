; ============================================================================
; 啟動載入程式 - 中文版本 (繁體中文)
; ============================================================================
; 這是計算機啟動時執行的第一段程式碼。
; BIOS 將此程式碼載入到位址 0x7C00 並跳轉執行。
;
; 為什麼是 0x7C00？歷史原因：早期 PC 保證有 32 KB 的 RAM。
; 0x7C00 = 31.75 KB，為 BIOS 留下空間。
; ============================================================================

[bits 16]                   ; 告訴組譯器生成 16 位元程式碼
                            ; 為什麼？CPU 以「真實模式」(16 位元)啟動
                            ; 真實模式只能定址 1 MB 的 RAM

[org 0x7C00]                ; 原點：所有位址相對於 0x7C00
                            ; 為什麼？因為 BIOS 將我們的程式碼載入這裡
                            ; 沒有這個，記憶體位址會錯誤

啟動開始:
    ; ------------------------------------------------------------------------
    ; 步驟 1：初始化記憶體區段
    ; ------------------------------------------------------------------------
    ; 在真實模式中，位址計算為：區段 × 16 + 偏移
    ; 我們想要區段為 0，這樣偏移 = 真實位址
    
    移動 ax, 0              ; AX = 0
                            ; 為什麼用 AX？不能直接移動到 DS/ES/SS
                            
    移動 ds, ax             ; DS (資料區段) = 0
                            ; 為什麼？以便不帶額外偏移存取資料
                            
    移動 es, ax             ; ES (額外區段) = 0
                            ; 為什麼？用於字串操作 (movsb 等)
                            
    移動 ss, ax             ; SS (堆疊區段) = 0
                            ; 為什麼？使堆疊位於前 64KB
                            
    移動 sp, 0x7C00         ; SP (堆疊指標) = 0x7C00
                            ; 為什麼是 0x7C00？堆疊向下成長
                            ; 這樣不會覆寫我們的程式碼 (位於 0x7C00+)
    
    ; ------------------------------------------------------------------------
    ; 步驟 2：從磁碟載入核心
    ; ------------------------------------------------------------------------
    ; 需要讀取磁碟的第 2-11 扇區 (我們的核心)
    ; 第 1 扇區是此啟動載入程式，核心從第 2 扇區開始
    
    移動 ah, 0x02           ; AH = 0x02 → BIOS 功能「讀取扇區」
                            ; 為什麼是 0x02？INT 13h 的功能代碼
                            
    移動 al, 10             ; AL = 10 → 要讀取的扇區數量
                            ; 為什麼是 10？我們的核心佔用 10 個扇區 (5 KB)
                            ; 每個扇區 = 512 位元組
                            
    移動 ch, 0              ; CH = 0 → 柱面編號
                            ; 為什麼是 0？磁碟的第一個柱面
                            
    移動 cl, 2              ; CL = 2 → 扇區編號
                            ; 為什麼是 2？扇區 1 是啟動載入程式，從 2 開始
                            
    移動 dh, 0              ; DH = 0 → 磁頭編號
                            ; 為什麼是 0？磁碟的第一個磁頭
                            
    移動 bx, 0x1000         ; ES:BX = 0x0000:0x1000 → 目標位址
                            ; 為什麼是 0x1000？要將核心載入到遠離啟動載入程式的位置
                            ; 0x1000 = RAM 開始後 4 KB
                            
    中斷 0x13               ; INT 13h → BIOS 磁碟操作呼叫
                            ; 做什麼？BIOS 將磁碟扇區讀取到 ES:BX
                            ; 如果失敗，CF (進位旗標) = 1
    
    ; ------------------------------------------------------------------------
    ; 步驟 3：顯示確認訊息
    ; ------------------------------------------------------------------------
    
    移動 si, 載入訊息       ; SI = 訊息位址
                            ; 為什麼用 SI？印出函式期望位址在 SI
                            
    呼叫 印出               ; 呼叫我們的印出函式
                            ; 做什麼？在螢幕上顯示「正在載入核心...」
    
    ; ------------------------------------------------------------------------
    ; 步驟 4：跳轉到核心
    ; ------------------------------------------------------------------------
    
    跳躍 0x1000             ; JMP 0x1000 → 無條件跳躍
                            ; 為什麼？將控制權轉移到我們載入的核心
                            ; CPU 現在執行位於 0x1000 的程式碼

; ============================================================================
; 函式：印出
; ----------------------------------------------------------------------------
; 在螢幕上印出文字字串
; 
; 輸入：SI = 字串位址 (以 0 結尾)
; 輸出：無
; 修改：AX, BX (但會還原)
; ============================================================================
印出:
    推入 ax                 ; PUSH AX → 將 AX 儲存到堆疊
                            ; 為什麼？為了不遺失其原始值
                            
    推入 bx                 ; PUSH BX → 將 BX 儲存到堆疊
                            ; 為什麼？我們要修改它，但呼叫者可能需要它
                            
.循環:
    載入有效位址 si         ; LODSB → AL = [DS:SI]，然後 SI++
                            ; 做什麼？載入 SI 指向的位元組到 AL
                            ; 並自動遞增 SI
                            ; 為什麼有用？便於遍歷字串
                            
    若相等 .完成            ; JE .完成 → 如果是 0，結束
                            ; 為什麼？到達字串末尾
    
    移動 ah, 0x0E           ; AH = 0x0E → 功能「電傳打字輸出」
                            ; 為什麼？這是 BIOS 印出字元的功能
                            
    移動 bx, 0x07           ; BX = 0x07 → 顏色屬性 (黑底白字)
                            ; 為什麼？BH = 頁面，BL = 顏色
                            
    中斷 0x10               ; INT 10h → BIOS 影像呼叫
                            ; 做什麼？在螢幕上印出 AL 中的字元
                            
    跳躍 .循環              ; JMP .循環 → 回到迴圈開始
                            ; 為什麼？印出下一個字元
    
.完成:
    彈出 bx                 ; POP BX → 還原 BX 的原始值
                            ; 為什麼？使呼叫者不會注意到我們修改了它
                            
    彈出 ax                 ; POP AX → 還原 AX 的原始值
                            ; 注意：POP 的順序與 PUSH 相反 (LIFO - 後進先出)
                            
    返回                    ; RET → 返回呼叫者
                            ; 如何運作？從堆疊彈出返回位址並跳轉到該位址

; ============================================================================
; 資料
; ============================================================================
載入訊息 db '正在載入核心...', 13, 10, 0
                            ; db = 定義位元組
                            ; 13 = 回車 (CR，返回行首)
                            ; 10 = 換行 (LF，新的一行)
                            ; 0 = Null 終止符 (標記字串結束)

; ============================================================================
; 啟動扇區簽名
; ----------------------------------------------------------------------------
; 扇區的最後 2 個位元組必須是 0xAA55，BIOS 才會
; 識別這是有效的啟動扇區。
; ============================================================================

times 510-($-$$) db 0       ; 用零填充到第 510 位元組
                            ; $ = 當前位置
                            ; $$ = 區段開始
                            ; $ - $$ = 到目前為止寫入的位元組數
                            ; 為什麼？扇區必須正好是 512 位元組
                            
dw 0xAA55                   ; dw = 定義字 (2 位元組)
                            ; 為什麼是 0xAA55？這是 BIOS 尋找的魔術簽名
                            ; 小端序：在記憶體中為 0x55, 0xAA
                            ; 沒有這個，BIOS 不會執行此程式碼
